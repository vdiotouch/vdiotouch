API_PORT=3000
APP_NAME=video-touch
DOWNLOAD_VIDEO_WORKER_PORT=3002
PROCESS_VIDEO_WORKER_PORT=3003
VALIDATE_VIDEO_WORKER_PORT=3004
UPLOAD_VIDEO_WORKER_PORT=3005
THUMBNAIL_WORKER_PORT=3006
SWAGGER_USERNAME=toufiq
SWAGGER_PASSWORD=1010

MONGO_DB_URL=mongodb://mongodb:27017/video_touch_db
RABBIT_MQ_URL=amqp://admin:admin@rabbitmq:5672
RABBIT_MQ_VIDEO_TOUCH_TOPIC_EXCHANGE=video_touch_topic_exchange
RABBIT_MQ_UPDATE_ASSET_STATUS_ROUTING_KEY=asset.update.status
RABBIT_MQ_UPDATE_ASSET_STATUS_QUEUE=update_asset_status_queue
RABBIT_MQ_UPDATE_FILE_STATUS_ROUTING_KEY=update.file.status
RABBIT_MQ_UPDATE_FILE_STATUS_QUEUE=update_file_status_queue
RABBIT_MQ_VALIDATE_VIDEO_ROUTING_KEY=video.validate
RABBIT_MQ_DOWNLOAD_VIDEO_ROUTING_KEY=video.download
RABBIT_MQ_VALIDATE_VIDEO_QUEUE=video_validate_queue

RABBIT_MQ_720P_PROCESS_VIDEO_ROUTING_KEY=video.process.720p
RABBIT_MQ_1080P_PROCESS_VIDEO_ROUTING_KEY=video.process.1080p
RABBIT_MQ_DOWNLOAD_VIDEO_QUEUE=video_download_queue

RABBIT_MQ_360P_PROCESS_VIDEO_ROUTING_KEY=video.process.360p
RABBIT_MQ_360p_PROCESS_VIDEO_QUEUE=video_360p_process_queue
RABBIT_MQ_360p_UPLOAD_VIDEO_QUEUE=video_360p_upload_queue
RABBIT_MQ_360p_UPLOAD_VIDEO_ROUTING_KEY=video.upload.360p

RABBIT_MQ_480P_PROCESS_VIDEO_ROUTING_KEY=video.process.480p
RABBIT_MQ_480p_PROCESS_VIDEO_QUEUE=video_480p_process_queue
RABBIT_MQ_480p_UPLOAD_VIDEO_QUEUE=video_480p_upload_queue
RABBIT_MQ_480p_UPLOAD_VIDEO_ROUTING_KEY=video.upload.480p


RABBIT_MQ_540P_PROCESS_VIDEO_ROUTING_KEY=video.process.540p
RABBIT_MQ_540p_PROCESS_VIDEO_QUEUE=video_540p_process_queue
RABBIT_MQ_540p_UPLOAD_VIDEO_QUEUE=video_5400p_upload_queue
RABBIT_MQ_540p_UPLOAD_VIDEO_ROUTING_KEY=video.upload.540p

RABBIT_MQ_7200P_PROCESS_VIDEO_ROUTING_KEY=video.process.720p
RABBIT_MQ_720p_PROCESS_VIDEO_QUEUE=video_720p_process_queue
RABBIT_MQ_720p_UPLOAD_VIDEO_QUEUE=video_7200p_upload_queue
RABBIT_MQ_720p_UPLOAD_VIDEO_ROUTING_KEY=video.upload.720p

MAX_VIDEO_SIZE_IN_BYTES=118708871

RABBIT_MQ_PROCESS_VIDEO_ROUTING_KEY=video.process.360p
RABBIT_MQ_PROCESS_VIDEO_QUEUE=video_360p_process_queue
RABBIT_MQ_UPLOAD_VIDEO_ROUTING_KEY=video.upload.360p
RABBIT_MQ_UPLOAD_VIDEO_QUEUE=video_360p_upload_queue

RABBIT_MQ_THUMBNAIL_GENERATION_ROUTING_KEY=video.thumbnail
RABBIT_MQ_THUMBNAIL_GENERATION_QUEUE=video_thumbnail_generation_queue
RABBIT_MQ_UPDATE_ASSET_ROUTING_KEY=asset.update
RABBIT_MQ_UPDATE_ASSET_QUEUE=update_asset_queue
DEFAULT_THUMBNAIL_URL=https://cdn.toufiq.dev/images/error_dark_thumb.svg

# Which object store the workers upload to: s3 | bunny | r2
STORAGE_PROVIDER=s3

# Required when STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Required when STORAGE_PROVIDER=r2 (Cloudflare R2).
# R2_ENDPOINT is optional; it defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Public base URL videos are served from. For R2, point this at the bucket's
# public r2.dev URL or your custom domain.
CDN_BASE_URL=
VIDEO_BASE_URL=

# CDN cache invalidation. CDN_PROVIDER selects which provider is purged when an
# asset becomes READY: gotipath | bunny | cloudflare.
CDN_PROVIDER=
# Cloudflare CDN (used when CDN_PROVIDER=cloudflare). Purges the master playlist
# by URL via the Cloudflare API using a scoped API token.
CLOUDFLARE_CDN_ZONE_ID=
CLOUDFLARE_CDN_API_TOKEN=
# Optional host only (no API version — that's pinned in code). Defaults to https://api.cloudflare.com
CLOUDFLARE_CDN_API_BASE_URL=
# Public base URL Cloudflare serves videos from (e.g. https://cdn.example.com).
# Used to build the absolute URL Cloudflare purges.
CLOUDFLARE_CDN_BASE_URL=
TEMP_UPLOAD_DIRECTORY=/temp/videos
TEMP_VIDEO_DIRECTORY=/temp/upload
JWT_SECRET=
JWT_EXPIRATION_TIME_IN_SEC=

# Webhook configuration for live-class recording events
WEBHOOK_URL=
WEBHOOK_TOKEN=

# SLA alerting (see specs/video-sla-alerting.md)
SLA_ALERTS_ENABLED=false
SLA_TARGET_MINUTES=60
SLA_WARNING_THRESHOLD_MINUTES=30
SLA_LOOKBACK_HOURS=24
SLA_CHECK_BATCH_LIMIT=500
SLA_DIGEST_THRESHOLD=5
SLA_MAX_DELIVERY_ATTEMPTS=5
SLA_SLACK_WEBHOOK_URL=
INTERNAL_API_KEY=
