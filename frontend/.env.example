# Backend API URL
VITE_VIDEO_TOUCH_API_URL=http://localhost:3000

# Pagination - number of videos per page
VITE_VIDEO_LIST_PAGE_SIZE=10

# Polling interval for data refresh (in seconds)
VITE_UPDATE_DATA_INTERVAL_IN_SECONDS=5

# Set to "true" once the API issues an httpOnly refresh cookie
# (POST /api/v1/auth/refresh). The access token is then kept in memory only.
VITE_AUTH_COOKIE_REFRESH=false

# Address behind the "Contact support" links on log in / sign up
VITE_SUPPORT_EMAIL=support@vdiotouch.com

# Largest video the api accepts, in MB, shown as "Max file size" in the import
# dialog. Match the api's MAX_VIDEO_SIZE_IN_BYTES (118708871 bytes = 113 MB).
# Leave empty to hide the hint.
VITE_MAX_VIDEO_SIZE_MB=113
